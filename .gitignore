/src/BlazorDataOrchestrator.Core/BlazorDataOrchestrator.Core.csproj.lscache

# Job projects are org-owned and belong in the organization's own repository, never in the product
# repo. Allowlist: everything under src/ is ignored except the product projects listed below, so a new
# job folder is ignored automatically in every fork without editing this file.
# Keep this block above the per-file rules that follow — the last matching pattern wins.
/src/*/
!/src/BlazorDataOrchestrator.Core/
!/src/BlazorDataOrchestrator.JobCreatorTemplate/
!/src/BlazorOrchestrator.Agent/
!/src/BlazorOrchestrator.AppHost/
!/src/BlazorOrchestrator.Scheduler/
!/src/BlazorOrchestrator.ServiceDefaults/
!/src/BlazorOrchestrator.Web/

# Auto-generated job template zip (built by scripts/Package-JobTemplate.ps1)
/src/BlazorOrchestrator.Web/JobTemplate/BlazorDataOrchestrator.JobCreatorTemplate.zip

# Visual Studio publish profiles are machine/environment specific
**/Properties/PublishProfiles/
*.pubxml
*.pubxml.user
docs/ProductionARMDeploymentPlan.md
docs/ProductionEnvironmentVariables.txt

# Staged copy of .github/skills used only inside the packaged template zip
/src/BlazorDataOrchestrator.JobCreatorTemplate/Skills/
