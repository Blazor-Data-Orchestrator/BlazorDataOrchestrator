# TFVC ignore for organizations that map a TFVC folder to this src folder for their own job projects.
# Only the organization's job projects belong in TFVC. The product itself is owned by the GitHub repo.
# A leading \ anchors to this folder; a bare name matches at any depth.

# --- Product projects: owned by the open-source repo, never checked into TFVC ---
\BlazorDataOrchestrator.Core
\BlazorDataOrchestrator.JobCreatorTemplate
\BlazorOrchestrator.Agent
\BlazorOrchestrator.AppHost
\BlazorOrchestrator.Scheduler
\BlazorOrchestrator.ServiceDefaults
\BlazorOrchestrator.Web
\.dockerignore

# --- Build output, IDE state and run-time artifacts, at any depth ---
bin
obj
.vs
*.user
*.suo
*.nupkg
execution_errors.log

# --- Python run-time artefacts written into Code\CodePython by the template UI and the Agent ---
__pycache__
*.pyc
runner.py
_runner.py
# Holds fully resolved settings, including connection strings
resolved.appsettings.json
