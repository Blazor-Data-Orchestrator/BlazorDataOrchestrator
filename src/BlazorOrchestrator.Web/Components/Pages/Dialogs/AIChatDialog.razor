        color: #b71c1c;
    }

    .ai-apply-details {
        flex: 1;
        min-width: 0;
        max-height: 160px;
        overflow-y: auto;
        font-size: 13px;
    }

    .ai-apply-file {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        margin: 2px 0;
