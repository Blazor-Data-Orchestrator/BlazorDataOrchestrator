</style>

@code {
    /// <summary>
    /// What the user has open: the active file, the primary code file (main.cs / main.py), and all job files.
    /// </summary>
    [Parameter, EditorRequired] public AIEditorContext EditorContext { get; set; } = AIEditorContext.ForSingleFile("csharp", "");
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>
    /// Raised with the validated file updates when the user clicks Apply. Every update names its target file.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyList<ProposedFileUpdate>> OnFileUpdatesApply { get; set; }
    /// <summary>
    /// When set, this prompt is automatically sent as soon as the dialog opens.
    /// The value is cleared after the first send so it does not re-fire on re-render.
    /// </summary>
    [Parameter] public string? InitialPrompt { get; set; }

    private ElementReference messagesContainer;
    private List<ChatMessageDisplay> Messages { get; set; } = new();
    private string sessionId = Guid.NewGuid().ToString();
    private string currentInput = "";
    private bool IsCallingAI = false;
    private AIResponseParseResult? pendingResult;
    private bool initialPromptSent = false;

    private string Language => EditorContext.Language;

    private string ApplyButtonText
    {
        get
        {
            var valid = pendingResult?.ValidUpdates ?? [];
            return valid.Count == 1 ? $"Apply to {valid[0].FileName}" : $"Apply {valid.Count} files";
        }
    }

    protected override void OnInitialized()
    {
        ChatService.SetEditorContext(EditorContext);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(InitialPrompt) && !initialPromptSent)
        {
            initialPromptSent = true;
            currentInput = InitialPrompt;
            StateHasChanged();
            await Task.Yield(); // allow UI to update before sending
            await SendMessage();
        }
    }

    protected override void OnParametersSet()
    {
        ChatService.SetEditorContext(EditorContext);
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentInput) || IsCallingAI)
            return;

        var userMessage = currentInput.Trim();
        currentInput = "";
        
        // Add user message
        Messages.Add(new ChatMessageDisplay
        {
            Content = userMessage,
            IsUser = true,
            Timestamp = DateTime.UtcNow
        });

        // Add placeholder for assistant response
        var assistantMessage = new ChatMessageDisplay
        {
            Content = "",
            IsUser = false,
            Timestamp = DateTime.UtcNow,
            IsStreaming = true
        };
        Messages.Add(assistantMessage);
        
        IsCallingAI = true;
        StateHasChanged();

        try
        {
            // Ensure the ChatService has the latest editor context
            var requestContext = EditorContext;
            ChatService.SetEditorContext(requestContext);
            pendingResult = null;

            var responseBuilder = new System.Text.StringBuilder();
            var lastRenderTime = DateTime.UtcNow;

            await foreach (var chunk in ChatService.GetCompletionsAsync(userMessage, sessionId))
            {
                responseBuilder.Append(chunk);
                assistantMessage.Content = responseBuilder.ToString();

                // Throttle UI updates to every 100ms to avoid overwhelming Blazor's
                // render pipeline on large streaming responses
                var now = DateTime.UtcNow;
                if ((now - lastRenderTime).TotalMilliseconds >= 100)
                {
                    lastRenderTime = now;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1); // yield to allow render cycle to complete
                }
            }

            // Final render to guarantee the complete response is displayed
            assistantMessage.Content = responseBuilder.ToString();
            assistantMessage.IsStreaming = false;
            
            // Find file updates in the complete response and validate them for their target file type
            CheckForFileUpdates(assistantMessage.Content, requestContext);
        }
        catch (Exception ex)
        {
            assistantMessage.Content = $"Sorry, I encountered an error: {ex.Message}";
            assistantMessage.IsStreaming = false;
        }
        finally
        {
            IsCallingAI = false;
            StateHasChanged();
        }
    }

    private void CheckForFileUpdates(string response, AIEditorContext requestContext)
    {
        var result = AIResponseFileUpdateParser.Parse(response, requestContext);
        pendingResult = result.Updates.Count > 0 || result.Warnings.Count > 0 ? result : null;
    }

    private string FormatMessage(string content)
    {
        if (string.IsNullOrEmpty(content))
            return "";

        // Normalize line endings to \n
        content = content.Replace("\r\n", "\n").Replace("\r", "\n");

        // Strip code markers from display (they appear as raw text otherwise)
        content = StripCodeMarkersForDisplay(content);

        // HTML encode the content first
        var result = System.Web.HttpUtility.HtmlEncode(content);

        // Replace fenced code blocks with placeholders to protect from <br/> injection.
        // The regex handles optional language identifiers and optional whitespace around them.
        var codeBlockIndex = 0;
        var codeBlocks = new System.Collections.Generic.Dictionary<string, string>();
        result = System.Text.RegularExpressions.Regex.Replace(
            result,
            @"```[ \t]*(\w*)[ \t]*\n([\s\S]*?)```",
            m =>
            {
                var placeholder = $"\x00CB{codeBlockIndex++}\x00";
                var lang = m.Groups[1].Value;
                var code = m.Groups[2].Value.TrimEnd('\n');
                codeBlocks[placeholder] = $"<pre><code>{code}</code></pre>";
                return placeholder;
            });

        // Handle unclosed code blocks (response may have been truncated by token limit)
        result = System.Text.RegularExpressions.Regex.Replace(
            result,
            @"```[ \t]*(\w*)[ \t]*\n([\s\S]+)$",
            m =>
            {
                var placeholder = $"\x00CB{codeBlockIndex++}\x00";
                var lang = m.Groups[1].Value;
                var code = m.Groups[2].Value.TrimEnd('\n');
                codeBlocks[placeholder] = $"<pre><code>{code}</code></pre>";
                return placeholder;
            });

        // Format inline code (but not already-processed triple backtick blocks)
        result = System.Text.RegularExpressions.Regex.Replace(
            result,
            @"`([^`]+)`",
            "<code>$1</code>");

        // Convert newlines to <br/> only outside code blocks
        result = result.Replace("\n", "<br/>");

        // Restore code blocks (newlines inside <pre> are preserved by the browser)
        foreach (var kvp in codeBlocks)
        {
            result = result.Replace(kvp.Key, kvp.Value);
        }

        return result;
    }

    /// <summary>
    /// Strips the file update markers from the message for display, leaving the explanation text,
    /// a bold label for each named file, and the code blocks.
    /// </summary>
    private static string StripCodeMarkersForDisplay(string content)
    {
        if (string.IsNullOrEmpty(content))
            return content;

        return AIResponseFileUpdateParser.StripMarkersForDisplay(content).Trim();
    }

    private async Task ApplyUpdatesToEditor()
    {
        var updates = pendingResult?.ValidUpdates ?? [];
        if (updates.Count == 0)
        {
            return;
        }

        pendingResult = null;
        await OnFileUpdatesApply.InvokeAsync(updates);
    }

    private async Task AskAIToFix()
    {
        if (pendingResult is null || IsCallingAI)
        {
            return;
        }

        var problems = new System.Text.StringBuilder();
        foreach (var update in pendingResult.InvalidUpdates)
        {
            foreach (var error in update.Validation.Errors)
            {
                problems.AppendLine($"- {update.FileName}: {error}");
            }
        }
        foreach (var update in pendingResult.ValidUpdates)
        {
            foreach (var warning in update.Validation.Warnings)
            {
                problems.AppendLine($"- {update.FileName}: {warning}");
            }
        }
        foreach (var warning in pendingResult.Warnings)
        {
            problems.AppendLine($"- {warning}");
        }

        currentInput =
            "Your previous response could not be applied because of these problems:\n" +
            problems +
            $"\nReturn corrected, complete files. Put code for {EditorContext.PrimaryCodeFileName} inside ###UPDATED CODE BEGIN### / ###UPDATED CODE END###, " +
            "put any other file inside ###UPDATED FILE BEGIN: <file name>### / ###UPDATED FILE END###, " +
            "never put code in .json files, and make every .json file strictly valid JSON.";
        await SendMessage();
    }

    private void DismissPendingCode()
    {
        pendingResult = null;
    }

    private async Task OnCloseClick()
    {
        await OnClose.InvokeAsync();
    }

    private void OnOverlayClick()
    {
        // Optional: uncomment to close on overlay click
        // await OnClose.InvokeAsync();
    }

    private void ClearConversation()
    {
        ChatService.ClearSession(sessionId);
        sessionId = Guid.NewGuid().ToString();
        Messages.Clear();
        pendingResult = null;
        StateHasChanged();
        NotificationService.Notify(NotificationSeverity.Info, "Cleared", "Conversation history cleared.");
    }

    private bool showSettings = false;

    private void OpenSettingsDialog()
    {
        showSettings = true;
    }

    private void CloseSettings()
    {
        showSettings = false;
    }

    private void OnSettingsSaved()
    {
        ChatService.RefreshClient();
        showSettings = false;
        NotificationService.Notify(NotificationSeverity.Success, "Success", "AI settings updated.");
    }

    private class ChatMessageDisplay
    {
        public string Content { get; set; } = "";
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; }
        public bool IsStreaming { get; set; }
    }
}
