    }

    .message-text code {
        background: rgba(0, 0, 0, 0.08);
        padding: 2px 6px;
        border-radius: 4px;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.875em;
    }

    .message-text pre code {
        background: none;
        padding: 0;
        white-space: pre;
        word-wrap: normal;
    }

    .message-streaming {
        margin-top: 8px;
    }

    .streaming-indicator {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: #5c6bc0;
        border-radius: 50%;
        animation: pulse 1s infinite;
