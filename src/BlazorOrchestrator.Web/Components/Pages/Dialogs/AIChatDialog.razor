    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    .chat-input-area {
        display: flex;
        gap: 12px;
        padding: 16px;
        border-top: 1px solid #e0e0e0;
        background: white;
    }

    .chat-textarea {
        flex: 1;
