@using Radzen
@using Radzen.Blazor
@using BlazorOrchestrator.Web.Components.Shared

<RadzenStack Gap="16" Style="padding: 8px;">
    <AIServiceSettingsEditor Compact="true" ShowSaveButton="true" ShowStatusCard="false"
                             OnSaved="@OnSaved" />
</RadzenStack>

@code {
    [Parameter] public EventCallback OnSettingsSaved { get; set; }

    private async Task OnSaved()
    {
        await OnSettingsSaved.InvokeAsync();
    }
}
