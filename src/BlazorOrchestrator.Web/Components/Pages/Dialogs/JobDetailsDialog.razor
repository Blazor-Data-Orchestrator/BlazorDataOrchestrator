    // Code Editor Methods
    private async Task OnLanguageChanged(object value)
    {
        // The value parameter contains the new language selected by the user
        // codeLanguage is already updated via @bind-Value before this fires
        var newLanguage = value?.ToString() ?? codeLanguage;
        var oldLanguage = codeLanguage;
        
        // Capture old code before reset for change logging
        var oldMainFile = oldLanguage == "csharp" ? "main.cs" : "main.py";
        var oldCode = FileStorage.GetFile(JobId, oldMainFile) ?? currentJobCode;
        
        // Ensure codeLanguage is set correctly (defensive, should already be set by binding)
        if (!string.IsNullOrEmpty(newLanguage))
        {
            codeLanguage = newLanguage;
        }
        
        _logger.LogInformation("Language changed to: {Language}", codeLanguage);

        // Log language switch
        if (Job != null)
        {
            _ = Task.Run(async () =>
            {
                try { await CodeChangeLog.LogCodeChangeAsync(Job.Id, oldMainFile, oldLanguage, "LanguageSwitch", oldCode, null, $"Switched from {oldLanguage} to {codeLanguage}"); }
                catch { }
            });
        }
        
        // Reset loaded package state - we're starting fresh with new language
        // Don't reload from package because existing package is for the old language
        hasLoadedPackageFiles = false;
        loadedCodeModel = null;
        codeEditorInitialized = false;
        
        // Clear file storage for this job to start fresh
        FileStorage.ClearFiles(JobId);
        
        // Set default file list based on new language
        if (codeLanguage == "csharp")
        {
            codeFileList = new List<string> { "main.cs", "appsettings.json", "appsettings.Production.json", "BlazorDataOrchestrator.Job.nuspec" };
        }
        else if (codeLanguage == "python")
        {
            codeFileList = new List<string> { "main.py", "appsettings.json", "appsettings.Production.json", "requirements.txt" };
        }
        
        selectedCodeFile = codeFileList.FirstOrDefault();
        previousSelectedFile = selectedCodeFile;
        
        // Load default template for the new language (don't reload package)
        currentJobCode = CodeEditorService.GetDefaultTemplate(codeLanguage);
        
        // Store files in file storage
        if (!string.IsNullOrEmpty(selectedCodeFile))
        {
            FileStorage.SetFile(JobId, selectedCodeFile, currentJobCode);
        }
        
        // Initialize other default files
        FileStorage.SetFile(JobId, "appsettings.json", CodeEditorService.GetDefaultAppSettings());
        FileStorage.SetFile(JobId, "appsettings.Production.json", CodeEditorService.GetDefaultAppSettings());
        if (codeLanguage == "python")
        {
            FileStorage.SetFile(JobId, "requirements.txt", "");
        }
        
        // Update editor state
        FileStorage.SetEditorState(JobId, new EditorState 
        { 
            Language = codeLanguage, 
            SelectedFile = selectedCodeFile 
        });
        
        codeEditorInitialized = true;
        
        if (jobCodeEditor != null)
        {
            await jobCodeEditor.UpdateCodeAsync(currentJobCode);
            await jobCodeEditor.UpdateLanguageAsync(GetMonacoLanguageForJob());
        }
        
        StateHasChanged();
    }

    private async Task OnCodeFileChanged()
    {
        if (string.IsNullOrEmpty(selectedCodeFile)) return;
        
        // Save current code before switching
        if (jobCodeEditor != null && !string.IsNullOrEmpty(previousSelectedFile))
        {
            var code = await jobCodeEditor.GetCodeAsync();
            
            // Save to loadedCodeModel if available
            if (loadedCodeModel != null)
            {
                CodeEditorService.SetFileContent(loadedCodeModel, previousSelectedFile, code);
            }
            
            // Also save to file storage
            FileStorage.SetFile(JobId, previousSelectedFile, code);
            
            // If the previous file was a .nuspec, re-parse dependencies
            if (previousSelectedFile?.EndsWith(".nuspec", StringComparison.OrdinalIgnoreCase) == true)
            {
                var parsedDependencies = CodeEditorService.ParseNuSpecDependencies(code);
                FileStorage.SetDependencies(JobId, parsedDependencies);
                FileStorage.SetNuspecContent(JobId, code, previousSelectedFile);
                
                if (loadedCodeModel != null)
                {
                    loadedCodeModel.Dependencies = parsedDependencies;
                    loadedCodeModel.NuspecContent = code;
                }
                
                Console.WriteLine($"[OnCodeFileChanged] Re-parsed {parsedDependencies.Count} dependencies from edited .nuspec");
            }
        }
        
        // Load new file content
        string fileContent;
        
        if (loadedCodeModel != null)
        {
            // Get content from the loaded code model
            fileContent = CodeEditorService.GetFileContent(loadedCodeModel, selectedCodeFile);
        }
        else
        {
            // Try to get from file storage
            fileContent = FileStorage.GetFile(JobId, selectedCodeFile) ?? "";
        }
        
        if (string.IsNullOrEmpty(fileContent))
        {
            // Generate default content based on file type
            fileContent = GetDefaultContentForFile(selectedCodeFile);
            
            // Store the default content
            if (loadedCodeModel != null)
            {
                CodeEditorService.SetFileContent(loadedCodeModel, selectedCodeFile, fileContent);
            }
            FileStorage.SetFile(JobId, selectedCodeFile, fileContent);
        }
        
        currentJobCode = fileContent;
        previousSelectedFile = selectedCodeFile;
        
        // Update editor state
        var state = FileStorage.GetEditorState(JobId) ?? new EditorState();
        state.SelectedFile = selectedCodeFile;
        FileStorage.SetEditorState(JobId, state);
        
        if (jobCodeEditor != null)
        {
            await jobCodeEditor.UpdateCodeAsync(currentJobCode);
            await jobCodeEditor.UpdateLanguageAsync(GetMonacoLanguageForJob());
        }
        
        StateHasChanged();
    }

    private string GetDefaultContentForFile(string fileName)
    {
        var lowerFileName = fileName.ToLowerInvariant();
        
        if (lowerFileName.EndsWith(".nuspec"))
        {
            return CodeEditorService.GetDefaultNuspecTemplate();
        }
        if (lowerFileName.EndsWith(".json"))
        {
            return CodeEditorService.GetDefaultAppSettings();
        }
        if (lowerFileName.EndsWith(".cs") || lowerFileName.EndsWith(".py"))
        {
            return CodeEditorService.GetDefaultTemplate(codeLanguage);
        }
        if (lowerFileName == "requirements.txt")
        {
            return "# Python dependencies\n# Add your pip packages here\n";
        }
        
        return "";
    }

