    private async Task InitializeCodeEditor()
    {
        if (Job == null || codeEditorInitialized) return;
        
        try
        {
            // Initialize with default template
            currentJobCode = CodeEditorService.GetDefaultTemplate(codeLanguage);
            
            // Set default file list based on language
            if (codeLanguage == "csharp")
            {
                codeFileList = new List<string> { "main.cs", "appsettings.json", "appsettings.Production.json" };
            }
            else
            {
                codeFileList = new List<string> { "main.py", "appsettings.json", "appsettings.Production.json" };
            }
            
            selectedCodeFile = codeFileList.FirstOrDefault();
            previousSelectedFile = selectedCodeFile;
            
            if (!string.IsNullOrEmpty(selectedCodeFile))
            {
                FileStorage.SetFile(JobId, selectedCodeFile, currentJobCode);
                FileStorage.SetFile(JobId, "appsettings.json", CodeEditorService.GetDefaultAppSettings());
                FileStorage.SetFile(JobId, "appsettings.Production.json", CodeEditorService.GetDefaultAppSettings());
            }
            
            codeEditorInitialized = true;
            
            // Update editor if already rendered
            if (jobCodeEditor != null)
            {
                await jobCodeEditor.UpdateCodeAsync(currentJobCode);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Warning", 
                $"Could not initialize code editor: {ex.Message}");
            currentJobCode = CodeEditorService.GetDefaultTemplate(codeLanguage);
            codeEditorInitialized = true;
        }
        
        StateHasChanged();
    }

    private async Task SaveAndCompileCode()
    {
        if (jobCodeEditor == null || Job == null) return;
        
        isCompilingCode = true;
        StateHasChanged();
        
        try
        {
            // Get current code from editor
            currentJobCode = await jobCodeEditor.GetCodeAsync();
            
            // Capture previous content before updating storage (for change logging)
            var mainFileForLog = codeLanguage == "csharp" ? "main.cs" : "main.py";
            var previousMainCode = FileStorage.GetFile(JobId, mainFileForLog);

            // Save current file to storage and loadedCodeModel
            if (!string.IsNullOrEmpty(selectedCodeFile))
            {
                FileStorage.SetFile(JobId, selectedCodeFile, currentJobCode);
                if (loadedCodeModel != null)
                {
                    CodeEditorService.SetFileContent(loadedCodeModel, selectedCodeFile, currentJobCode);
                }
                
                // If the current file is .nuspec, re-parse dependencies before saving
                if (selectedCodeFile?.EndsWith(".nuspec", StringComparison.OrdinalIgnoreCase) == true)
                {
                    var parsedDependencies = CodeEditorService.ParseNuSpecDependencies(currentJobCode);
                    FileStorage.SetDependencies(JobId, parsedDependencies);
                    FileStorage.SetNuspecContent(JobId, currentJobCode, selectedCodeFile);
                    
                    if (loadedCodeModel != null)
                    {
                        loadedCodeModel.Dependencies = parsedDependencies;
                        loadedCodeModel.NuspecContent = currentJobCode;
                    }
                    
                    Console.WriteLine($"[SaveAndCompileCode] Re-parsed {parsedDependencies.Count} dependencies from edited .nuspec");
                }
            }
            
            // Get the main code file for compilation
            var mainFileName = codeLanguage == "csharp" ? "main.cs" : "main.py";
            var mainCode = FileStorage.GetFile(JobId, mainFileName) ?? currentJobCode;
            
            // --- Auto-parse // NUGET: headers from main.cs into .nuspec ---
            if (codeLanguage == "csharp")
            {
                var headerDeps = CodeEditorService.ParseNuGetHeadersFromCode(mainCode);

                if (headerDeps.Any())
                {
                    var existingNuspec = loadedCodeModel?.NuspecContent;
                    // Also check file storage if loadedCodeModel doesn't have it
                    if (string.IsNullOrWhiteSpace(existingNuspec))
                    {
                        var (storedNuspec, _) = FileStorage.GetNuspecInfo(JobId);
                        existingNuspec = storedNuspec;
                    }

                    string updatedNuspec;
                    if (!string.IsNullOrWhiteSpace(existingNuspec))
                    {
                        // Check if existing nuspec actually has real dependencies (not just commented-out ones)
                        var existingParsedDeps = CodeEditorService.ParseNuSpecDependencies(existingNuspec);
                        if (existingParsedDeps.Any())
                        {
                            updatedNuspec = CodeEditorService.MergeNuGetDependencies(existingNuspec, headerDeps);
                        }
                        else
                        {
                            updatedNuspec = CodeEditorService.GenerateNuspecFromDependencies(headerDeps);
                        }
                    }
                    else
                    {
                        updatedNuspec = CodeEditorService.GenerateNuspecFromDependencies(headerDeps);
                    }

                    // Store the generated/updated .nuspec
                    var nuspecFileName = loadedCodeModel?.NuspecFileName ?? "BlazorDataOrchestrator.Job.nuspec";
                    FileStorage.SetFile(JobId, nuspecFileName, updatedNuspec);
                    FileStorage.SetNuspecContent(JobId, updatedNuspec, nuspecFileName);

                    var parsedDeps = CodeEditorService.ParseNuSpecDependencies(updatedNuspec);
                    FileStorage.SetDependencies(JobId, parsedDeps);

                    if (loadedCodeModel != null)
                    {
                        loadedCodeModel.NuspecContent = updatedNuspec;
                        loadedCodeModel.NuspecFileName = nuspecFileName;
                        loadedCodeModel.Dependencies = parsedDeps;
                    }
                    else
                    {
                        // Create a minimal code model to hold the deps
                        loadedCodeModel = new JobCodeModel
                        {
                            Language = codeLanguage,
                            MainCode = mainCode,
                            NuspecContent = updatedNuspec,
                            NuspecFileName = nuspecFileName,
                            Dependencies = parsedDeps,
                            AppSettings = FileStorage.GetFile(JobId, "appsettings.json") ?? CodeEditorService.GetDefaultAppSettings(),
                            AppSettingsProduction = FileStorage.GetFile(JobId, "appsettings.Production.json") ?? CodeEditorService.GetDefaultAppSettings()
                        };
                    }

                    // Ensure .nuspec appears in the file dropdown
                    if (!codeFileList.Contains(nuspecFileName))
                    {
                        codeFileList.Add(nuspecFileName);
                    }

                    Console.WriteLine($"[SaveAndCompileCode] Auto-parsed {headerDeps.Count} NuGet deps from code headers → .nuspec ({parsedDeps.Count} total deps)");
                }
            }

            // Attempt compilation/validation
            CompilationResult compilationResult;
            if (codeLanguage == "csharp")
            {
                // Use dependency-aware compilation if dependencies are available
                if (loadedCodeModel?.Dependencies?.Any() == true)
                {
                    Console.WriteLine($"[SaveAndCompileCode] Found {loadedCodeModel.Dependencies.Count} dependencies to resolve:");
                    foreach (var dep in loadedCodeModel.Dependencies)
                    {
                        Console.WriteLine($"  - {dep.PackageId} v{dep.Version}");
                    }
                    compilationResult = await CSharpCompiler.CompileWithDependenciesAsync(
                        mainCode, loadedCodeModel.Dependencies);
                }
                else
                {
                    Console.WriteLine("[SaveAndCompileCode] No dependencies found in loadedCodeModel, using default references");
                    // Fall back to dependency-aware compilation without explicit deps
                    // (still loads standard references like EF Core, BlazorDataOrchestrator.Core)
                    compilationResult = await CSharpCompiler.CompileWithDependenciesAsync(mainCode);
                }
            }
            else
            {
                compilationResult = PythonValidator.Validate(mainCode);
            }
            
            if (!compilationResult.Success)
            {
                // Log failed compilation
                _ = Task.Run(async () =>
                {
                    try { await CodeChangeLog.LogCodeChangeAsync(Job.Id, mainFileName, codeLanguage, "CompileFailed", mainCode, previousMainCode, $"Compilation failed: {compilationResult.Errors.Count} error(s)"); }
                    catch { }
                });

                // Show compilation errors in popup dialog
                await ShowCompilationErrorsDialog(compilationResult.Errors);
                return;
            }
            
            // Compilation successful - create NuGet package and upload
            var codeModel = FileStorage.ToCodeModel(JobId);
            var blobName = await PackageService.CreateAndUploadPackageAsync(Job.Id, codeModel);
            
            // Update job record
            Job.JobCodeFile = blobName;
            
            // Mark that we've saved, so next load will get this version
            hasLoadedPackageFiles = false;

            // Log successful compilation
            _ = Task.Run(async () =>
            {
                try { await CodeChangeLog.LogCodeChangeAsync(Job.Id, mainFileName, codeLanguage, "CompileSuccess", mainCode, previousMainCode, "Compiled and saved successfully"); }
                catch { }
            });
            
            NotificationService.Notify(NotificationSeverity.Success, "Success", 
                "Code compiled and saved successfully!");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", 
                $"Failed to save code: {ex.Message}");
        }
        finally
        {
            isCompilingCode = false;
            StateHasChanged();
        }
    }

