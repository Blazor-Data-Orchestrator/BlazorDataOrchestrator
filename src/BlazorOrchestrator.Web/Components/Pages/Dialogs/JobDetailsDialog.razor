                                  Click="@(async () => { ds.Close(); await OpenAIChatDialogWithPrompt("Please fix build errors"); })" />
                    <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="@(() => ds.Close())" />
                </RadzenStack>
            </RadzenStack>,
            new DialogOptions { Width = "600px", Height = "auto" }
        );
    }

    private async Task RunJobWithCode()
    {
        if (Job == null) return;
        
        isRunningJobWithCode = true;
        StateHasChanged();
        
        try
        {
            // If in editor mode, save and compile first
            if (codeEditMode == CodeEditMode.Editor && jobCodeEditor != null)
            {
                currentJobCode = await jobCodeEditor.GetCodeAsync();
                
                // Save current file to storage and loadedCodeModel
                if (!string.IsNullOrEmpty(selectedCodeFile))
                {
                    FileStorage.SetFile(JobId, selectedCodeFile, currentJobCode);
                    if (loadedCodeModel != null)
                    {
                        CodeEditorService.SetFileContent(loadedCodeModel, selectedCodeFile, currentJobCode);
                    }
                    
                    // If the current file is .nuspec, re-parse dependencies before running
                    if (selectedCodeFile?.EndsWith(".nuspec", StringComparison.OrdinalIgnoreCase) == true)
                    {
                        var parsedDependencies = CodeEditorService.ParseNuSpecDependencies(currentJobCode);
                        FileStorage.SetDependencies(JobId, parsedDependencies);
                        FileStorage.SetNuspecContent(JobId, currentJobCode, selectedCodeFile);
                        
                        if (loadedCodeModel != null)
                        {
                            loadedCodeModel.Dependencies = parsedDependencies;
                            loadedCodeModel.NuspecContent = currentJobCode;
                        }
                        
                        Console.WriteLine($"[RunJobWithCode] Re-parsed {parsedDependencies.Count} dependencies from edited .nuspec");
                    }
                }
                
                // Get the main code file for compilation
                var mainFileName = codeLanguage == "csharp" ? "main.cs" : "main.py";
                var mainCode = FileStorage.GetFile(JobId, mainFileName) ?? currentJobCode;
                
                // Compile code with dependencies
                CompilationResult compilationResult;
                if (codeLanguage == "csharp")
                {
                    // Use dependency-aware compilation if dependencies are available
                    if (loadedCodeModel?.Dependencies?.Any() == true)
                    {
                        compilationResult = await CSharpCompiler.CompileWithDependenciesAsync(
                            mainCode, loadedCodeModel.Dependencies);
                    }
                    else
                    {
                        // Fall back to dependency-aware compilation without explicit deps
                        // (still loads standard references like EF Core, BlazorDataOrchestrator.Core)
                        compilationResult = await CSharpCompiler.CompileWithDependenciesAsync(mainCode);
                    }
                }
                else
                {
                    compilationResult = PythonValidator.Validate(mainCode);
                }
                
                if (!compilationResult.Success)
                {
                    await ShowCompilationErrorsDialog(compilationResult.Errors);
                    return;
                }
                
                // Create and upload NuGet package
                var codeModel = FileStorage.ToCodeModel(JobId);
                var blobName = await PackageService.CreateAndUploadPackageAsync(Job.Id, codeModel);
                
                Job.JobCodeFile = blobName;
            }
            else if (string.IsNullOrEmpty(Job.JobCodeFile))
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Warning", 
                    "Please upload a NuGet package or write code before running the job.");
                return;
            }
            
            // Queue job for execution with Agent
            var jobInstanceId = await JobManager.RunJobNowAsync(Job.Id);
            
            NotificationService.Notify(NotificationSeverity.Success, "Job Queued", 
                $"Job has been queued for execution. Instance ID: {jobInstanceId}");
            
            // Switch to Logs tab and refresh
            SelectedTabIndex = 3; // Logs tab index
            await RefreshLogs();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", 
                $"Failed to run job: {ex.Message}");
        }
        finally
        {
            isRunningJobWithCode = false;
            StateHasChanged();
        }
    }

