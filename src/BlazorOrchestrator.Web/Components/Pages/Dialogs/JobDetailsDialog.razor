    private async Task OnAICodeApplied(string code)
    {
        // Capture previous content for change logging
        var previousCode = currentJobCode;

        // Check for embedded .nuspec content in the AI response
        var nuspecMatch = Regex.Match(code,
            @"###NUSPEC BEGIN###\s*```xml\s*(.*?)\s*```\s*###NUSPEC END###",
            RegexOptions.Singleline);

        if (!nuspecMatch.Success)
        {
            // Also try without the fenced code block (plain XML)
            nuspecMatch = Regex.Match(code,
                @"###NUSPEC BEGIN###\s*(.*?)\s*###NUSPEC END###",
                RegexOptions.Singleline);
        }

        if (nuspecMatch.Success && codeLanguage == "csharp")
        {
            var nuspecContent = nuspecMatch.Groups[1].Value.Trim();
            var nuspecFileName = loadedCodeModel?.NuspecFileName
                ?? "BlazorDataOrchestrator.Job.nuspec";

            // Store the .nuspec
            FileStorage.SetFile(JobId, nuspecFileName, nuspecContent);
            FileStorage.SetNuspecContent(JobId, nuspecContent, nuspecFileName);

            var parsedDeps = CodeEditorService.ParseNuSpecDependencies(nuspecContent);
            FileStorage.SetDependencies(JobId, parsedDeps);

            if (loadedCodeModel != null)
            {
                loadedCodeModel.NuspecContent = nuspecContent;
                loadedCodeModel.NuspecFileName = nuspecFileName;
                loadedCodeModel.Dependencies = parsedDeps;
            }

            // Ensure .nuspec appears in the file dropdown
            if (!codeFileList.Contains(nuspecFileName))
            {
                codeFileList.Add(nuspecFileName);
            }

            // Remove the nuspec block from the code applied to the editor
            code = Regex.Replace(code,
                @"###NUSPEC BEGIN###.*?###NUSPEC END###",
                "", RegexOptions.Singleline).Trim();

            Console.WriteLine($"[OnAICodeApplied] Extracted .nuspec with {parsedDeps.Count} dependencies from AI response");
        }

        // Apply the cleaned code to the editor
        currentJobCode = code;
        
        if (jobCodeEditor != null)
        {
            await jobCodeEditor.UpdateCodeAsync(code);
        }
        
        // Update file storage
        if (!string.IsNullOrEmpty(selectedCodeFile))
        {
            FileStorage.SetFile(JobId, selectedCodeFile, code);
            
            // Also update loadedCodeModel if available
            if (loadedCodeModel != null)
            {
                CodeEditorService.SetFileContent(loadedCodeModel, selectedCodeFile, code);
            }
        }
        
        showAIChatDialog = false;

        // Log AI fix
        if (Job != null && !string.IsNullOrEmpty(selectedCodeFile))
        {
            _ = Task.Run(async () =>
            {
                try { await CodeChangeLog.LogCodeChangeAsync(Job.Id, selectedCodeFile, codeLanguage, "AIFix", code, previousCode, "AI fix applied"); }
                catch { }
            });
        }

        NotificationService.Notify(NotificationSeverity.Success, "Code Applied", 
            "AI-generated code has been applied to the editor.");
        StateHasChanged();
    }

    private string GetCurrentNuspecContent()
    {
        if (codeLanguage != "csharp") return "";

        // Try loadedCodeModel first
        if (!string.IsNullOrEmpty(loadedCodeModel?.NuspecContent))
            return loadedCodeModel.NuspecContent;

        // Try file storage
        var (content, _) = FileStorage.GetNuspecInfo(JobId);
        if (!string.IsNullOrEmpty(content))
            return content;

        // Try file storage by file name
        var storedFile = FileStorage.GetFile(JobId, "BlazorDataOrchestrator.Job.nuspec");
        return storedFile ?? "";
    }

    // Change History Methods
    private async Task LoadChangeHistory()
    {
        if (Job == null) return;

        isLoadingHistory = true;
        historySkip = 0;
        StateHasChanged();

        try
        {
            changeHistory = await CodeChangeLog.GetChangeHistoryAsync(Job.Id, historyPageSize, 0);
            changeHistoryCount = await CodeChangeLog.GetChangeCountAsync(Job.Id);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to load change history for job {JobId}", Job.Id);
            changeHistory = new();
        }
        finally
        {
            isLoadingHistory = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreHistory()
    {
        if (Job == null) return;

        historySkip += historyPageSize;
        try
        {
            var moreHistory = await CodeChangeLog.GetChangeHistoryAsync(Job.Id, historyPageSize, historySkip);
            changeHistory.AddRange(moreHistory);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to load more change history for job {JobId}", Job.Id);
        }
        StateHasChanged();
    }

    private async Task ViewSnapshot(BlazorOrchestrator.Web.Data.Data.JobCodeChangeLog change)
    {
        if (string.IsNullOrEmpty(change.SnapshotRowKey) || Job == null) return;

        var content = await CodeChangeLog.GetSnapshotContentAsync(Job.Id, change.SnapshotRowKey);
        if (content == null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Snapshot content not found.");
            return;
        }

        await DialogService.OpenAsync($"{change.ChangeType} - {change.FileName} ({change.CreatedDate:yyyy-MM-dd HH:mm})", ds =>
            @<RadzenStack Gap="0.5rem" Style="padding: 0.5rem;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenBadge BadgeStyle="@GetChangeTypeBadgeStyle(change.ChangeType)" Text="@change.ChangeType" />
                    <RadzenText TextStyle="TextStyle.Caption">by @change.UserName</RadzenText>
                </RadzenStack>
                <pre style="max-height: 400px; overflow: auto; background: #1e1e1e; color: #d4d4d4; padding: 1rem; border-radius: 8px; font-family: 'Consolas', monospace; font-size: 12px; white-space: pre-wrap;">@content</pre>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="@(() => ds.Close())" />
                </RadzenStack>
            </RadzenStack>,
            new DialogOptions { Width = "800px", Height = "600px" }
        );
    }

    private async Task RestoreSnapshot(BlazorOrchestrator.Web.Data.Data.JobCodeChangeLog change)
    {
        if (string.IsNullOrEmpty(change.SnapshotRowKey) || Job == null) return;

        var confirmed = await DialogService.Confirm(
            $"This will replace the current editor content with the version from {change.CreatedDate:yyyy-MM-dd HH:mm:ss} UTC. You can undo this before saving.",
            "Restore Snapshot",
            new ConfirmOptions { OkButtonText = "Restore", CancelButtonText = "Cancel" });

        if (confirmed != true) return;

        var content = await CodeChangeLog.GetSnapshotContentAsync(Job.Id, change.SnapshotRowKey);
        if (content == null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Snapshot content not found.");
            return;
        }

        var previousCode = currentJobCode;
        currentJobCode = content;

        // Update file storage
        if (!string.IsNullOrEmpty(change.FileName))
        {
            FileStorage.SetFile(JobId, change.FileName, content);
            if (loadedCodeModel != null)
            {
                CodeEditorService.SetFileContent(loadedCodeModel, change.FileName, content);
            }
        }

        // Switch to Editor mode and update the editor
        codeEditMode = CodeEditMode.Editor;
        
        // If the restored file is different from the currently selected one, switch to it
        if (change.FileName != selectedCodeFile && codeFileList.Contains(change.FileName))
        {
            selectedCodeFile = change.FileName;
            previousSelectedFile = selectedCodeFile;
        }

        await LoadPackageFilesAsync();
        if (jobCodeEditor != null)
        {
            await jobCodeEditor.UpdateCodeAsync(content);
        }

        // Log the restore
        _ = Task.Run(async () =>
        {
            try { await CodeChangeLog.LogCodeChangeAsync(Job.Id, change.FileName, change.Language ?? codeLanguage, "Restore", content, previousCode, $"Restored from snapshot {change.CreatedDate:yyyy-MM-dd HH:mm}"); }
            catch { }
        });

        NotificationService.Notify(NotificationSeverity.Success, "Restored", "Code restored from history snapshot. Save & Compile to apply.");
        StateHasChanged();
    }

    private static BadgeStyle GetChangeTypeBadgeStyle(string changeType)
    {
        return changeType switch
        {
            "CompileSuccess" => BadgeStyle.Success,
            "CompileFailed" => BadgeStyle.Danger,
            "LanguageSwitch" => BadgeStyle.Info,
            "AIFix" => BadgeStyle.Warning,
            "Load" => BadgeStyle.Light,
            "Restore" => BadgeStyle.Secondary,
            "FileEdit" => BadgeStyle.Primary,
            _ => BadgeStyle.Light
        };
    }
