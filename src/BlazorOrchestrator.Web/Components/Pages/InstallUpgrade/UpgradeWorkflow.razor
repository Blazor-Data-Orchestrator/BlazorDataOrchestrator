@using BlazorOrchestrator.Web.Data
@using BlazorOrchestrator.Web.Data.Data
@using BlazorOrchestrator.Web.Services
@using BlazorDataOrchestrator.Core
@using BlazorDataOrchestrator.Core.Services
@inject WizardStateService WizardState
@inject IConfiguration Configuration
@inject SettingsService SettingsService
@inject AuthService AuthService
@inject AuthenticationSettings AuthSettings
@inject ILoggerFactory LoggerFactory

@code {
    [Parameter]
    public EventCallback OnUpgradeComplete { get; set; }

    [Parameter]
    public string CurrentCodeVersion { get; set; } = ApplicationVersion.Current;

    [Parameter]
    public string DatabaseVersion { get; set; } = ApplicationVersion.Current;

    [Parameter]
    public bool IsAdminAuthenticated { get; set; }

    /// <summary>Folder holding the !SQL scripts (tests point it elsewhere).</summary>
    [Parameter]
    public string? ScriptDirectory { get; set; }

    /// <summary>Script names the build shipped with (tests override it).</summary>
    [Parameter]
    public IReadOnlyList<string>? ExpectedScripts { get; set; }

    // login -> check -> running -> complete | failed; "missing" when the deployment lost scripts
    public string Stage { get; set; } = "login";
    public List<string> Logs = new();
    public string Username { get; set; } = string.Empty;
    public string Password { get; set; } = string.Empty;
    public string ErrorMessage { get; set; } = string.Empty;
    private bool IsBusy { get; set; }
    private List<string> PendingScripts { get; set; } = new();
    private IReadOnlyList<string> MissingScripts { get; set; } = Array.Empty<string>();
    private IReadOnlyList<string> AppliedScripts { get; set; } = Array.Empty<string>();

    private string ScriptFolder => ScriptDirectory ?? SqlScriptCatalog.DefaultDirectory;

    private const string ExternalButtonStyle = "display: flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; padding: 0.625rem; background-color: #ffffff; color: #3c4043; border: 1px solid #dadce0; border-radius: 4px; font-size: 0.875rem; font-weight: 500; cursor: pointer; text-decoration: none; box-sizing: border-box;";

    protected override void OnParametersSet()
    {
        WizardState.SetUpgrading(true);

        if (Stage == "login" && (IsAdminAuthenticated || WizardState.IsAdminAuthenticated))
        {
            EnterCheckStage();
        }
    }

    /// <summary>Shows the scripts that will run, or a deployment error when scripts are missing.</summary>
    private void EnterCheckStage()
    {
        MissingScripts = SqlScriptCatalog.FindMissing(ScriptFolder, ExpectedScripts ?? SqlScriptCatalog.ExpectedScripts);
        if (MissingScripts.Count > 0)
        {
            Stage = "missing";
            return;
        }

        PendingScripts = SqlScriptCatalog.GetPendingScripts(Directory.EnumerateFiles(ScriptFolder, "*.sql"), DatabaseVersion, CurrentCodeVersion)
            .Select(path => Path.GetFileName(path))
            .ToList();
        Stage = "check";
    }

    private async Task Authenticate()
    {
        ErrorMessage = string.Empty;

        if (string.IsNullOrEmpty(Username) || string.IsNullOrEmpty(Password))
        {
            ErrorMessage = "Please enter username and password.";
            return;
        }

        IsBusy = true;
        try
        {
            var user = await AuthService.ValidateCredentialsAsync(Username, Password);
            if (user == null)
            {
                ErrorMessage = "Invalid username or password.";
                return;
            }

            if (!await AuthService.IsActiveAdminAsync(user.Id))
            {
                ErrorMessage = "Only administrators can perform upgrades.";
                return;
            }

            WizardState.SetAdminAuthenticated(user.UserName ?? Username, user.Id);
            Password = string.Empty;
            EnterCheckStage();
        }
        catch (Exception ex)
        {
            // A database outage must not end the circuit; the user can retry.
            LoggerFactory.CreateLogger("UpgradeWizard").LogWarning(ex, "Upgrade Wizard sign-in failed.");
            ErrorMessage = "Could not verify the administrator account right now. Check the database connection and try again.";
        }
        finally
        {
            IsBusy = false;
        }
    }

    /// <summary>Re-checks, right before the scripts run, that the signed-in user is still an active Admin.</summary>
    private async Task<bool> IsStillAuthorizedAsync()
    {
        if (!WizardState.IsAdminAuthenticated)
        {
            ErrorMessage = "Please sign in with an administrator account.";
            Stage = "login";
            return false;
        }

        try
        {
            if (await AuthService.IsActiveAdminAsync(WizardState.AuthenticatedAdminUserId))
            {
                return true;
            }

            WizardState.ClearAdminAuthenticated();
            ErrorMessage = "Your account is no longer an active administrator. Sign in with an administrator account.";
            Stage = "login";
            return false;
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger("UpgradeWizard").LogWarning(ex, "Upgrade Wizard authorization check failed.");
            ErrorMessage = "Could not verify the administrator account right now. Check the database connection and try again.";
            return false;
        }
    }

    private void AddLog(string message)
    {
        Logs.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
        InvokeAsync(StateHasChanged);
    }

    private async Task RunScripts()
    {
        if (IsBusy) return;
        ErrorMessage = string.Empty;
        IsBusy = true;

        try
        {
            if (!await IsStillAuthorizedAsync())
            {
                return;
            }

            var connStr = Configuration.GetConnectionString("blazororchestratordb");
            if (string.IsNullOrEmpty(connStr))
            {
                ErrorMessage = "No blazororchestratordb connection string is configured.";
                return;
            }

            Stage = "running";
            Logs.Clear();
            StateHasChanged();

            var logger = LoggerFactory.CreateLogger("UpgradeWizard");
            logger.LogInformation("Upgrade Wizard started by {UserName}.", WizardState.AuthenticatedAdminName);
            AddLog($"Upgrade started by {WizardState.AuthenticatedAdminName}. Database version {DatabaseVersion} → code version {CurrentCodeVersion}.");

            var result = await DatabaseInitializer.ApplyPendingScriptsAsync(
                connStr,
                CurrentCodeVersion,
                new SettingsSchemaVersionStore(SettingsService),
                logger,
                AddLog,
                ScriptFolder,
                ExpectedScripts ?? SqlScriptCatalog.ExpectedScripts);

            AppliedScripts = result.AppliedScripts;
            DatabaseVersion = result.CurrentVersion;
            AddLog($"✓ Upgrade completed. Schema version is now {DatabaseVersion}.");
            Stage = "complete";
        }
        catch (MissingSqlScriptsException ex)
        {
            MissingScripts = ex.MissingScripts;
            Stage = "missing";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            AddLog($"✗ {ex.Message}");
            if (ex is SchemaScriptFailedException)
            {
                AddLog("The failed script was rolled back; scripts before it stay applied.");
            }
            await RefreshDatabaseVersionAsync();
            Stage = "failed";
        }
        finally
        {
            IsBusy = false;
            StateHasChanged();
        }
    }

    private async Task RefreshDatabaseVersionAsync()
    {
        try
        {
            DatabaseVersion = await new SettingsSchemaVersionStore(SettingsService).GetAsync() ?? DatabaseVersion;
            PendingScripts = SqlScriptCatalog.GetPendingScripts(Directory.EnumerateFiles(ScriptFolder, "*.sql"), DatabaseVersion, CurrentCodeVersion)
                .Select(path => Path.GetFileName(path))
                .ToList();
        }
        catch
        {
            // Keep the last known version; the error is already shown.
        }
    }

    private async Task FinishUpgrade()
    {
        if (OnUpgradeComplete.HasDelegate)
        {
            await OnUpgradeComplete.InvokeAsync();
        }
    }
}

@if (Stage == "login")
{
    <div class="d-flex justify-content-center rz-mt-5">
        <RadzenCard Style="width: 450px;" Class="rz-shadow-5">
            <div class="text-center rz-mb-4">
                <RadzenIcon Icon="system_update" IconColor="@Colors.Warning" Style="font-size: 3rem;" />
                <RadzenText TextStyle="TextStyle.H5" Class="rz-mt-2">Database Upgrade Required</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-base-500">
                    Database Version: <strong>@DatabaseVersion</strong> | Code Version: <strong>@CurrentCodeVersion</strong>
                </RadzenText>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter" Class="rz-mb-3">
                    @ErrorMessage
                </RadzenAlert>
            }

            <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-mb-3">Administrator Authentication</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-base-500 rz-mb-3">
                Only administrators can run database upgrades. Sign in with your admin account to continue.
            </RadzenText>
            <div class="rz-mb-3">
                <RadzenTextBox @bind-Value="Username" Placeholder="Username or Email" Style="width: 100%;" />
            </div>
            <div class="rz-mb-4">
                <RadzenPassword @bind-Value="Password" Placeholder="Password" Style="width: 100%;" />
            </div>
            <RadzenButton Click="@Authenticate" Text="Authorize Upgrade" Style="width: 100%;" ButtonStyle="ButtonStyle.Primary" IsBusy="@IsBusy" BusyText="Checking..." />

            @if (AuthSettings.IsMicrosoftConfigured || AuthSettings.IsGoogleConfigured)
            {
                <div class="rz-mt-4" style="border-top: 1px solid #e0e0e0; padding-top: 1rem;">
                    <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-base-500 rz-mb-3 text-center">Or sign in with an external provider</RadzenText>
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        @if (AuthSettings.IsMicrosoftConfigured)
                        {
                            <a href="/account/upgrade-external-login?provider=Microsoft" data-enhance="false" style="@ExternalButtonStyle">
                                <svg width="18" height="18" viewBox="0 0 21 21" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                                    <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                                    <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                                    <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                                </svg>
                                Sign in with Microsoft
                            </a>
                        }
                        @if (AuthSettings.IsGoogleConfigured)
                        {
                            <a href="/account/upgrade-external-login?provider=Google" data-enhance="false" style="@ExternalButtonStyle">
                                <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                </svg>
                                Sign in with Google
                            </a>
                        }
                    </div>
                </div>
            }
        </RadzenCard>
    </div>
}
else if (Stage == "check" || Stage == "failed")
{
    <div class="d-flex justify-content-center rz-mt-5">
        <RadzenCard Style="width: 600px;" Class="rz-shadow-5">
            <div class="d-flex justify-content-between align-items-center rz-mb-5 rz-px-4">
                <div class="text-center">
                    <RadzenText TextStyle="TextStyle.Overline">DATABASE VERSION</RadzenText>
                    <RadzenText TextStyle="TextStyle.H4">@DatabaseVersion</RadzenText>
                </div>
                <RadzenIcon Icon="arrow_forward" Style="font-size: 2rem; color: #ccc;" />
                <div class="text-center">
                    <RadzenText TextStyle="TextStyle.Overline">CODE VERSION</RadzenText>
                    <RadzenText TextStyle="TextStyle.H4" Class="rz-color-primary">@CurrentCodeVersion</RadzenText>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter" Class="rz-mb-3">
                    @if (Stage == "failed")
                    {
                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Div">Upgrade stopped</RadzenText>
                    }
                    @ErrorMessage
                </RadzenAlert>
            }

            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Div">Database Migration Required</RadzenText>
                @if (PendingScripts.Count > 0)
                {
                    <span>These scripts will be applied, each in its own transaction: <strong>@string.Join(", ", PendingScripts)</strong>.</span>
                }
                else
                {
                    <span>No schema changes are needed for this version; the schema version will be recorded as @CurrentCodeVersion.</span>
                }
            </RadzenAlert>

            @if (Stage == "failed" && Logs.Count > 0)
            {
                <div class="rz-mt-3" style="background-color: #1e1e1e; color: #ff8080; padding: 12px; max-height: 200px; overflow-y: auto; font-family: 'Consolas', 'Courier New', monospace; font-size: 12px;">
                    @foreach (var log in Logs)
                    {
                        <div>@log</div>
                    }
                </div>
            }

            <RadzenButton Click="RunScripts" Text="@(Stage == "failed" ? "Retry Upgrade" : "Apply Upgrade")" ButtonStyle="ButtonStyle.Primary" Style="width: 100%; margin-top: 1rem;" Icon="upgrade" IsBusy="@IsBusy" BusyText="Checking..." />
        </RadzenCard>
    </div>
}
else if (Stage == "missing")
{
    <div class="d-flex justify-content-center rz-mt-5">
        <RadzenCard Style="width: 600px;" Class="rz-shadow-5">
            <div class="text-center rz-mb-4">
                <RadzenIcon Icon="report" IconColor="@Colors.Danger" Style="font-size: 3rem;" />
                <RadzenText TextStyle="TextStyle.H5" Class="rz-mt-2">Deployment Is Missing Upgrade Scripts</RadzenText>
            </div>
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
                The database cannot be upgraded from <strong>@DatabaseVersion</strong> to <strong>@CurrentCodeVersion</strong>
                because these schema scripts are missing from this deployment:
                <strong>@string.Join(", ", MissingScripts)</strong>.
                Redeploy the release (or restore its <code>!SQL</code> folder) and open BlazorOrchestrator again.
                Nothing was changed in the database.
            </RadzenAlert>
        </RadzenCard>
    </div>
}
else if (Stage == "running")
{
    <div class="d-flex justify-content-center rz-mt-5">
        <RadzenCard Style="width: 700px;" Class="rz-p-0">
            <div class="rz-p-3 rz-background-color-base-200" style="border-bottom: 1px solid #e0e0e0;">
                <div class="d-flex align-items-center gap-2">
                    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="width: 100px; height: 6px;" />
                    <RadzenText TextStyle="TextStyle.Subtitle2" Class="rz-m-0">Applying Upgrade Scripts...</RadzenText>
                </div>
            </div>
            <div style="background-color: #1e1e1e; color: #00ff00; padding: 20px; height: 350px; overflow-y: auto; font-family: 'Consolas', 'Courier New', monospace; font-size: 13px;">
                @foreach (var log in Logs)
                {
                    <div style="margin-bottom: 4px;">@log</div>
                }
                <div class="rz-mt-2" style="animation: blink 1s infinite;">▌</div>
            </div>
        </RadzenCard>
    </div>
}
else if (Stage == "complete")
{
    <div class="d-flex justify-content-center rz-mt-5">
        <RadzenCard Style="width: 500px;" Class="rz-shadow-5">
            <div class="text-center rz-mb-4">
                <RadzenIcon Icon="check_circle" IconColor="@Colors.Success" Style="font-size: 4rem;" />
                <RadzenText TextStyle="TextStyle.H5" Class="rz-mt-2">Upgrade Complete!</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-base-500">
                    Database has been upgraded to version <strong>@DatabaseVersion</strong>
                </RadzenText>
            </div>

            <RadzenCard Class="rz-background-color-base-100 rz-mb-4">
                <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0">
                    <strong>Summary:</strong>
                </RadzenText>
                <ul style="margin-bottom: 0; padding-left: 20px;">
                    <li>@(AppliedScripts.Count == 0 ? "No migration scripts were needed" : $"Scripts applied: {string.Join(", ", AppliedScripts)}")</li>
                    <li>Schema version updated to @DatabaseVersion</li>
                </ul>
            </RadzenCard>

            <div style="background-color: #1e1e1e; color: #00ff00; padding: 12px; max-height: 200px; overflow-y: auto; font-family: 'Consolas', 'Courier New', monospace; font-size: 12px;" class="rz-mb-4">
                @foreach (var log in Logs)
                {
                    <div>@log</div>
                }
            </div>

            <RadzenButton Click="FinishUpgrade" Text="Continue to Sign In" Style="width: 100%;" ButtonStyle="ButtonStyle.Success" Icon="arrow_forward" />
        </RadzenCard>
    </div>
}

<style>
    @@keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }
</style>
