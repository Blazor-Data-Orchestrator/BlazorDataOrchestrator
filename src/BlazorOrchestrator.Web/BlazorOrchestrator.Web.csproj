<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Auto-package the JobCreatorTemplate zip before build. The zip is not tracked in git; it is
       rebuilt whenever the content hash of its inputs changes (timestamps are unreliable after a checkout). -->
  <PropertyGroup>
    <JobTemplateSourceDir>$(MSBuildProjectDirectory)\..\BlazorDataOrchestrator.JobCreatorTemplate</JobTemplateSourceDir>
    <JobTemplateZip>$(MSBuildProjectDirectory)\JobTemplate\BlazorDataOrchestrator.JobCreatorTemplate.zip</JobTemplateZip>
    <JobTemplateScript>$(MSBuildProjectDirectory)\..\..\scripts\Package-JobTemplate.ps1</JobTemplateScript>
    <JobTemplatePowerShell Condition="$([MSBuild]::IsOSPlatform('Windows'))">powershell.exe</JobTemplatePowerShell>
    <JobTemplatePowerShell Condition="'$(JobTemplatePowerShell)' == ''">pwsh</JobTemplatePowerShell>
  </PropertyGroup>
  <ItemGroup>
    <JobTemplateInputs Include="$(JobTemplateSourceDir)\**\*.*" Exclude="$(JobTemplateSourceDir)\bin\**;$(JobTemplateSourceDir)\obj\**;$(JobTemplateSourceDir)\.vs\**;$(JobTemplateSourceDir)\Properties\**;$(JobTemplateSourceDir)\**\*.csproj.user;$(JobTemplateSourceDir)\**\*.suo;$(JobTemplateSourceDir)\execution_errors.log;$(JobTemplateSourceDir)\Code\**\__pycache__\**" />
    <JobTemplateInputs Include="$(MSBuildProjectDirectory)\JobTemplate\JobCreatorTemplate.slnx.template" />
    <JobTemplateInputs Include="$(JobTemplateScript)" />
  </ItemGroup>
  <Target Name="PackageJobTemplate" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <JobTemplateHashFile>$(IntermediateOutputPath)jobtemplate.inputs.hash</JobTemplateHashFile>
    </PropertyGroup>
    <GetFileHash Files="@(JobTemplateInputs)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_JobTemplateHashed" />
    </GetFileHash>
    <PropertyGroup>
      <!-- '|' rather than ';' so WriteLinesToFile keeps it on one line and the comparison below is exact. -->
      <_JobTemplateCombined>@(_JobTemplateHashed->'%(RecursiveDir)%(Filename)%(Extension)=%(FileHash)', '|')</_JobTemplateCombined>
      <_JobTemplatePrevious Condition="Exists('$(JobTemplateHashFile)')">$([System.IO.File]::ReadAllText('$(JobTemplateHashFile)').Trim())</_JobTemplatePrevious>
    </PropertyGroup>
    <Exec Condition="!Exists('$(JobTemplateZip)') Or '$(_JobTemplateCombined)' != '$(_JobTemplatePrevious)'"
          Command="$(JobTemplatePowerShell) -NoProfile -ExecutionPolicy Bypass -File &quot;$(JobTemplateScript)&quot; -SourceDir &quot;$(JobTemplateSourceDir)&quot; -OutputZip &quot;$(JobTemplateZip)&quot;" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(JobTemplateHashFile)" Lines="$(_JobTemplateCombined)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Exclude Mockups folder from compilation - these are reference files only -->
  <ItemGroup>
    <Compile Remove="Mockups\**" />
    <Content Remove="Mockups\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="JobTemplate\BlazorDataOrchestrator.JobCreatorTemplate.zip" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="JobTemplate\BlazorDataOrchestrator.JobCreatorTemplate.zip">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="efpt.config.json.user" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorOrchestrator.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Data.Tables" Version="13.5.4" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.5.4" />
    <PackageReference Include="Aspire.Azure.Storage.Queues" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.5.4" />
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.5.4" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.0" />
    <PackageReference Include="Radzen.Blazor" Version="*" />
    <PackageReference Include="SimpleBlazorMonaco" Version="1.0.9" />
    <!-- AI packages for ConfigureAIDialog connection testing -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
    <PackageReference Include="Mscc.GenerativeAI" Version="3.1.0" />
    <!-- External authentication providers -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorDataOrchestrator.Core\BlazorDataOrchestrator.Core.csproj" />
    <ProjectReference Include="..\BlazorOrchestrator.ServiceDefaults\BlazorOrchestrator.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
  <None Update="!SQL\01.20.00.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="!SQL\01.10.00.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="!SQL\01.00.00.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
