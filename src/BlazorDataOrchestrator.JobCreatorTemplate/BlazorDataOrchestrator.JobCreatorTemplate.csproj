<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- AI skill files (single source of truth: the repo's .github/skills). Inside the repo they are
       linked directly; in an extracted template zip, Package-JobTemplate.ps1 has staged a copy
       under Skills\ next to this project. -->
  <PropertyGroup>
    <RepoAISkillsRoot>$(MSBuildProjectDirectory)\..\..\.github\skills</RepoAISkillsRoot>
    <LocalAISkillsRoot>$(MSBuildProjectDirectory)\Skills</LocalAISkillsRoot>
    <AISkillsRoot Condition="Exists('$(RepoAISkillsRoot)\coding-a-job-csharp\SKILL.md')">$(RepoAISkillsRoot)</AISkillsRoot>
    <AISkillsRoot Condition="'$(AISkillsRoot)' == ''">$(LocalAISkillsRoot)</AISkillsRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Skills\**" />
    <Content Remove="Skills\**" />
    <EmbeddedResource Include="$(AISkillsRoot)\coding-a-job-csharp\SKILL.md"
                      LogicalName="Skills/coding-a-job-csharp/SKILL.md"
                      Link="Skills\coding-a-job-csharp\SKILL.md" />
    <EmbeddedResource Include="$(AISkillsRoot)\coding-a-job-python\SKILL.md"
                      LogicalName="Skills/coding-a-job-python/SKILL.md"
                      Link="Skills\coding-a-job-python\SKILL.md" />
  </ItemGroup>

  <Target Name="EnsureAISkillFiles" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(AISkillsRoot)\coding-a-job-csharp\SKILL.md')"
           Text="Missing AI skill file for C#. Expected under $(RepoAISkillsRoot) or $(LocalAISkillsRoot)." />
    <Error Condition="!Exists('$(AISkillsRoot)\coding-a-job-python\SKILL.md')"
           Text="Missing AI skill file for Python. Expected under $(RepoAISkillsRoot) or $(LocalAISkillsRoot)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Data.Tables" Version="13.5.4" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.5.4" />
    <PackageReference Include="Aspire.Azure.Storage.Queues" Version="13.5.4" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
	<PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.5.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="*" />
    <PackageReference Include="Radzen.Blazor" Version="*" />
	<PackageReference Include="SimpleBlazorMonaco" Version="1.0.9" />  
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorDataOrchestrator.Core\BlazorDataOrchestrator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json;appsettings.Development.json;appsettings.Staging.json;appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Code\" />
  </ItemGroup>

</Project>
